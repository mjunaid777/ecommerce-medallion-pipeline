{
  "datasets": [
    {
      "name": "39b96676",
      "displayName": "vw_fact_orders_enriched",
      "config": {
        "version": "1.1",
        "source": "ete.gold.vw_fact_orders_enriched",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "top_products",
      "displayName": "Top 5 Products by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT product, SUM(total_amount_usd) AS total_revenue FROM ete.gold.vw_fact_orders_enriched GROUP BY product ORDER BY total_revenue DESC LIMIT 5\n",
        "dimensions": [
          {
            "name": "product",
            "expr": "source.product",
            "displayName": "Product"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(source.total_revenue)",
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
  ],
